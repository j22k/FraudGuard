# FraudGuard Environment Variables
# Auto-generated by: terraform apply (in infra/terraform/)
# Copy this to .env and fill in values manually, OR just run terraform apply
# which generates .env automatically.

AWS_REGION=us-east-1
SAGEMAKER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/fraudguard-sagemaker-execution-role
FRAUDGUARD_S3_BUCKET=fraudguard-data-dev-XXXXXXXX
FRAUDGUARD_DYNAMODB_TABLE=fraudguard-flagged-transactions-dev
FRAUDGUARD_MODEL_PACKAGE_GROUP=fraudguard-model-group
LAMBDA_EXECUTION_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/fraudguard-lambda-execution-role
