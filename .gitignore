.aws/
*.pem

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment (auto-generated by Terraform — contains account-specific ARNs)
.env

# Docs — internal notes and files containing real AWS account IDs / ARNs
docs/status.md
docs/phases.md

# AI assistant context — internal, not project content
claude.md

# Data — raw + processed datasets are large, use S3/DVC
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs
*.log
logs/

# Lambda
lambda/*.zip
lambda/package/

# ML — model artifacts are large binaries, stored in S3 not git
ml/models/
ml/experiments/
ml/model_artifacts/*.json
ml/model_artifacts/*.pkl
ml/model_artifacts/*.tar.gz
ml/model_artifacts/*.bin
# Keep feature_list.txt — it's small and documents the feature schema
!ml/model_artifacts/feature_list.txt

# SageMaker — local SDK cache and temp outputs
.sagemaker/
sagemaker-*/

.agents